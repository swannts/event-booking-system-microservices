generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_FAILED
  BOOKING_CANCELLED
}

model Notification {
  id            String           @id @db.Uuid
  type          NotificationType
  messageId     String           @unique @map("message_id") @db.Uuid
  correlationId String           @map("correlation_id") @db.Uuid
  bookingId     String           @map("booking_id") @db.Uuid
  eventId       String           @map("event_id") @db.Uuid
  message       String
  reason        String?
  occurredAt    DateTime         @map("occurred_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@map("notifications")
  @@index([createdAt])
}

model ProcessedNotificationMessage {
  messageId   String   @id @map("message_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_notification_messages")
}
