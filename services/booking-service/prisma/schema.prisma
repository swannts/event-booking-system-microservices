generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model Booking {
  id             String        @id @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  quantity       Int
  status         BookingStatus
  idempotencyKey String?       @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("bookings")
}

model BookingIdempotencyKey {
  key                String   @id
  bookingId          String   @unique @map("booking_id")
  requestFingerprint String   @map("request_fingerprint")
  response           Json
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("booking_idempotency_keys")
}

model ProcessedBookingMessage {
  messageId   String   @id @map("message_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_booking_messages")
}

model BookingOutboxEvent {
  id           String       @id @db.Uuid
  topic        String
  messageId    String       @unique @map("message_id")
  message      Json
  status       OutboxStatus  @default(PENDING)
  attempts     Int          @default(0)
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at")
  claimedAt    DateTime?    @map("claimed_at")
  claimedBy    String?      @map("claimed_by")
  lastError    String?      @map("last_error")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  publishedAt  DateTime?    @map("published_at")

  @@map("booking_outbox_events")
  @@index([status, nextAttemptAt, createdAt])
}
