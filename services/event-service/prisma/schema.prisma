generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id             String   @id @db.Uuid
  title          String
  date           DateTime
  totalSeats     Int      @map("total_seats")
  availableSeats  Int      @map("available_seats")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("events")
}

model ProcessedEventMessage {
  messageId   String   @id @map("message_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_event_messages")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model EventOutboxEvent {
  id          String      @id @db.Uuid
  topic       String
  messageId   String      @unique @map("message_id")
  message     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int         @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  claimedAt   DateTime?   @map("claimed_at")
  claimedBy   String?     @map("claimed_by")
  lastError   String?     @map("last_error")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  publishedAt DateTime?   @map("published_at")

  @@map("event_outbox_events")
  @@index([status, nextAttemptAt, createdAt])
}
